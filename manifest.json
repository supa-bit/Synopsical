{
  "name": "Synopsical — Personal Compendium",
  "short_name": "Synopsical",
  "description": "Write entries on anything worth remembering, cross-referenced with [[wiki-links]] and synced across every device.",
  "start_url": "/index.html",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f3f5f7",
